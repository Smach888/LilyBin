\version "2.24.1"
\header {
  title = "Hymne des Sentinelles de l'Enfance"
  subtitle = "Promotion 2023–2025 – INFPE Plateau Central et Sud-Ouest"
  composer = "DeepSeek Chat (arr.)"
  meter = "Solennel et joyeux"
  tempo = "Afro-acoustique, 72–76 BPM"
}

melodie = \relative c' {
  \key c \major
  \time 4/4
  \tempo "Couplet (doux et grave)" 4 = 72
  
  % Couplet 1
  \repeat volta 2 {
    c4 d e g | g a g e | 
    e g a a | g f e d |
    c d e g | g a b g |
    e g a a | g f e c \break
  }
  
  \tempo "Refrain (ferveur)" 4 = 76
  % Refrain
  g' g a b | c b a g |
  a a g e | f g f e |
  g g a b | c b a g |
  a g f e | d e c c \break
  
  % Couplet 2 (identique à Couplet 1 mélodiquement)
  \tempo "Couplet (fierté)"
  c4 d e g | g a g e |
  e g a a | g f e d |
  c d e g | g a b g |
  e g a a | g f e c \bar "|."
}

paroles = \lyricmode {
  % Couplet 1
  Nous som -- mes ve -- nus des plai -- nes et des col -- li -- nes,
  Por -- tés par le rê -- ve d’un mon -- de plus hu -- main.
  For -- més dans l’om -- bre des é -- co -- les qui s’in -- cli -- nent
  De -- vant l’en -- fant, le tout pe -- tit che -- min.
  
  % Refrain
  Sen -- ti -- nelles de l’en -- fan -- ce, de -- bout pour la lu -- miè -- re,
  Là où l’on é -- clai -- re l’en -- fant, la vi -- o -- len -- ce re -- cu -- le.
  Nos voix sont des se -- men -- ces, nos ges -- tes sont pri -- è -- res,
  Nous veil -- lons les cœurs fra -- gi -- les, en gar -- diens d’es -- pé -- ran -- ce.
  
  % Couplet 2
  For -- més à l’é -- cou -- te, à la paix, à la ten -- dres -- se,
  Dans les CEEP, nous a -- vons veil -- lé cha -- que ma -- tin.
  Gui -- dés par l’en -- fan -- ce, sa lu -- miè -- re, sa pro -- mes -- se,
  Pour bâ -- tir de -- main, là où tout prend son che -- min.
}

accords = \chordmode {
  % Couplets
  c g a:m f 
  % Refrain
  f g c a:m
}

\score {
  <<
    \new Staff \with { midiInstrument = "acoustic grand" } 
    <<
      \new Voice = "melodie" { \melodie }
      \new Lyrics \lyricsto "melodie" { \paroles }
    >>
    \new ChordNames { \accords }
  >>
  \layout { }
  \midi { }
}
